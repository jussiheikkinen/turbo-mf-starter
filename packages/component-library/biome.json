{
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["src/**/*", "lib/**/*", "components/**/*"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noNestedComponentDefinitions": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off",
        "noDoubleEquals": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  }
}
